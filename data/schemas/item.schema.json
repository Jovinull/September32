{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://september32.invalid/schemas/item.schema.json",
  "title": "Item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "display_name"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Stable item id, used by item()/has_item()."
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "grants": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "uniqueItems": true,
      "description": "Knowledge facts holding this item implies."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
