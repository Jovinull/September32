# Sprite placement. One transform per character, so that adjusting how
# a sprite sits on screen never means touching a scene script.

transform iris_base:
    zoom 1.0
    yoffset 0
    subpixel True

transform june_base:
    zoom 1.0
    yoffset 0
    subpixel True

transform mara_base:
    zoom 1.0
    yoffset 0
    subpixel True

transform noah_base:
    zoom 1.0
    yoffset 0
    subpixel True

transform theo_base:
    zoom 1.0
    yoffset 0
    subpixel True

# Stage positions, in the 1920x1080 design space.
transform s32_left:
    xalign 0.18
    yalign 1.0

transform s32_centre:
    xalign 0.5
    yalign 1.0

transform s32_right:
    xalign 0.82
    yalign 1.0


